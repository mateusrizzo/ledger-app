{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@screens": ["./src/screens"],
      "@screens/*": ["./src/screens/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@theme": ["./src/theme"],
      "@theme/*": ["./src/theme/*"],
      "@models": ["./src/types"],
      "@models/*": ["./src/types/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
